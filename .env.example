# İletişim ve kariyer formları (src/lib/mail.ts) için SMTP ayarları.
# Hostinger'da hPanel → Node.js uygulaması → Ortam değişkenleri altına girilmelidir.

# Kurumsal e-postanın SMTP sunucusu (bazgy.com için: mail.bazgy.com)
SMTP_HOST=
# 587 (STARTTLS) ya da 465 (SSL). 465 seçilirse bağlantı otomatik olarak şifreli açılır.
SMTP_PORT=587
# Zorunlu değil; 465 dışındaki portlarda SSL'i elle açmak için "true".
SMTP_SECURE=
# Gönderimi yapacak posta kutusu ve şifresi (Gmail/Outlook'ta "uygulama şifresi")
SMTP_USER=
SMTP_PASS=

# Mesajların düşeceği adres (varsayılan: info@bazgy.com)
CONTACT_TO=info@bazgy.com
# Gönderen adresi (varsayılan: SMTP_USER). Çoğu sağlayıcı SMTP_USER ile aynı olmasını ister.
CONTACT_FROM=
# Kariyer başvurularının düşeceği adres (varsayılan: CONTACT_TO)
CAREER_TO=

# Kanonik site adresi (sitemap, paylaşım önizlemeleri). Varsayılan: https://www.bazgy.com
NEXT_PUBLIC_SITE_URL=
